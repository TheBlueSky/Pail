<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pail.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Pail.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:AppThemeModeDisplayConverter x:Key="AppThemeModeDisplayConverter" />

        <x:Double x:Key="SettingsCardSpacing">4</x:Double>

        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="0,30,0,6" />
        </Style>

        <Style x:Key="SettingsCardBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        </Style>

        <Style
            x:Key="SettingsCardDescriptionTextBlockStyle"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <Grid
        x:Uid="SettingsMainRegion"
        AutomationProperties.LandmarkType="Main"
        AutomationProperties.LocalizedLandmarkType="Settings">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            MaxWidth="1064"
            Margin="36,24,36,0"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    x:Uid="SettingsTitle"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Settings" />
                <TextBlock
                    x:Uid="SettingsDescription"
                    Style="{StaticResource SettingsCardDescriptionTextBlockStyle}"
                    Text="Configure how Pail looks and which defaults it uses when you sign in, browse, and download." />
            </StackPanel>

            <Button
                x:Uid="SaveSettingsButton"
                Grid.Column="1"
                MinWidth="120"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.SaveCommand}"
                Content="Save"
                Style="{StaticResource AccentButtonStyle}"
                AutomationProperties.AcceleratorKey="Ctrl+S"
                ToolTipService.ToolTip="Save settings (Ctrl+S)">

                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="S" Modifiers="Control" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Padding="36,0,36,0"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel
                MaxWidth="1064"
                HorizontalAlignment="Center"
                Spacing="{StaticResource SettingsCardSpacing}">
                <StackPanel.ChildrenTransitions>
                    <RepositionThemeTransition />
                </StackPanel.ChildrenTransitions>

                <TextBlock
                    x:Uid="AppearanceSectionHeader"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="Appearance &amp; behavior"
                    AutomationProperties.HeadingLevel="Level2" />

                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Margin="0,4,0,0"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE790;"
                            AutomationProperties.AccessibilityView="Raw" />

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="AppThemeTitleText"
                                x:Uid="AppThemeTitle"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="App theme" />
                            <TextBlock
                                x:Uid="AppThemeDescription"
                                Style="{StaticResource SettingsCardDescriptionTextBlockStyle}"
                                Text="Choose whether the app follows the system theme or always uses a specific mode." />
                        </StackPanel>

                        <ComboBox
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            MinWidth="220"
                            ItemsSource="{x:Bind ViewModel.AvailableThemes}"
                            SelectedItem="{x:Bind ViewModel.AppTheme, Mode=TwoWay}"
                            AutomationProperties.LabeledBy="{Binding ElementName=AppThemeTitleText}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource AppThemeModeDisplayConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Margin="0,4,0,0"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE7F4;"
                            AutomationProperties.AccessibilityView="Raw" />

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="StatusMessagesTitleText"
                                x:Uid="StatusMessagesTitle"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Status messages" />
                            <TextBlock
                                x:Uid="StatusMessagesDescription"
                                Style="{StaticResource SettingsCardDescriptionTextBlockStyle}"
                                Text="Control how long transient status overlays stay visible before they dismiss." />
                        </StackPanel>

                        <NumberBox
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            MinWidth="160"
                            Minimum="1"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.StatusOverlayDurationSeconds, Mode=TwoWay}"
                            AutomationProperties.LabeledBy="{Binding ElementName=StatusMessagesTitleText}" />
                    </Grid>
                </Border>

                <TextBlock
                    x:Uid="ObjectBrowserSectionHeader"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="Object browser"
                    AutomationProperties.HeadingLevel="Level2" />

                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Margin="0,4,0,0"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE81C;"
                            AutomationProperties.AccessibilityView="Raw" />

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="InitialObjectLoadTitleText"
                                x:Uid="InitialObjectLoadTitle"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Initial object load" />
                            <TextBlock
                                x:Uid="InitialObjectLoadDescription"
                                Style="{StaticResource SettingsCardDescriptionTextBlockStyle}"
                                Text="Choose how many rows Pail loads the first time a bucket folder opens or refreshes." />
                            <TextBlock
                                x:Uid="InitialObjectLoadHint"
                                Style="{StaticResource SettingsCardDescriptionTextBlockStyle}"
                                Text="Values above 1000 are fetched through multiple S3 requests." />
                        </StackPanel>

                        <NumberBox
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Minimum="1"
                            MinWidth="160"
                            SmallChange="25"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.InitialObjectLoadCount, Mode=TwoWay}"
                            AutomationProperties.LabeledBy="{Binding ElementName=InitialObjectLoadTitleText}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Margin="0,4,0,0"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xF8A5;"
                            AutomationProperties.AccessibilityView="Raw" />

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="LoadMoreBatchTitleText"
                                x:Uid="LoadMoreBatchTitle"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Load more batch size" />
                            <TextBlock
                                x:Uid="LoadMoreBatchDescription"
                                Style="{StaticResource SettingsCardDescriptionTextBlockStyle}"
                                Text="Set to 0 to reuse the initial load count, or choose a different batch size for each Load more click." />
                            <TextBlock
                                x:Uid="LoadMoreBatchHint"
                                Style="{StaticResource SettingsCardDescriptionTextBlockStyle}"
                                Text="Values above 1000 are fetched through multiple S3 requests." />
                        </StackPanel>

                        <NumberBox
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Minimum="0"
                            MinWidth="160"
                            SmallChange="25"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.LoadMoreObjectCount, Mode=TwoWay}"
                            AutomationProperties.LabeledBy="{Binding ElementName=LoadMoreBatchTitleText}" />
                    </Grid>
                </Border>

                <TextBlock
                    x:Uid="DownloadsSectionHeader"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="Downloads"
                    AutomationProperties.HeadingLevel="Level2" />

                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Margin="0,4,0,0"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8B7;"
                            AutomationProperties.AccessibilityView="Raw" />

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="DefaultDownloadFolderTitleText"
                                x:Uid="DefaultDownloadFolderTitle"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Default download folder" />
                            <TextBlock
                                x:Uid="DefaultDownloadFolderDescription"
                                Style="{StaticResource SettingsCardDescriptionTextBlockStyle}"
                                Text="Choose where downloaded objects go unless you pick a different location." />
                        </StackPanel>

                        <Grid
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            MinWidth="360"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                x:Uid="DownloadFolderInput"
                                Grid.Column="0"
                                PlaceholderText="e.g. C:\Downloads\Pail"
                                Text="{x:Bind ViewModel.DownloadFolder, Mode=TwoWay}"
                                AutomationProperties.LabeledBy="{Binding ElementName=DefaultDownloadFolderTitleText}" />
                            <Button
                                x:Uid="BrowseDownloadFolderButton"
                                Grid.Column="1"
                                Command="{x:Bind ViewModel.BrowseDownloadFolderCommand}"
                                Content="Browse" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Margin="0,4,0,0"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xF89A;"
                            AutomationProperties.AccessibilityView="Raw" />

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="DownloadPromptsTitleText"
                                x:Uid="DownloadPromptsTitle"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Download prompts" />
                            <TextBlock
                                x:Uid="DownloadPromptsDescription"
                                Style="{StaticResource SettingsCardDescriptionTextBlockStyle}"
                                Text="Ask for a location every time before downloading an object." />
                        </StackPanel>

                        <ToggleSwitch
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            MinWidth="0"
                            IsOn="{x:Bind ViewModel.AlwaysPromptDownloadLocation, Mode=TwoWay}"
                            AutomationProperties.LabeledBy="{Binding ElementName=DownloadPromptsTitleText}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Margin="0,4,0,0"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE7C1;"
                            AutomationProperties.AccessibilityView="Raw" />

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="MaxParallelDownloadsTitleText"
                                x:Uid="MaxParallelDownloadsTitle"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Maximum parallel downloads" />
                            <TextBlock
                                x:Uid="MaxParallelDownloadsDescription"
                                Style="{StaticResource SettingsCardDescriptionTextBlockStyle}"
                                Text="Choose how many downloads Pail can run at once. Changes apply after restarting Pail." />
                        </StackPanel>

                        <NumberBox
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Minimum="1"
                            Maximum="10"
                            MinWidth="160"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.MaxParallelDownloads, Mode=TwoWay}"
                            AutomationProperties.LabeledBy="{Binding ElementName=MaxParallelDownloadsTitleText}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Margin="0,4,0,0"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE74C;"
                            AutomationProperties.AccessibilityView="Raw" />

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="AutoClearCompletedDownloadsTitleText"
                                x:Uid="AutoClearCompletedDownloadsTitle"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Auto-clear finished downloads" />
                            <TextBlock
                                x:Uid="AutoClearCompletedDownloadsDescription"
                                Style="{StaticResource SettingsCardDescriptionTextBlockStyle}"
                                Text="Remove completed and cancelled downloads from the queue after the delay. Failed downloads stay visible." />
                        </StackPanel>

                        <ToggleSwitch
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            MinWidth="0"
                            IsOn="{x:Bind ViewModel.AutoClearCompletedDownloads, Mode=TwoWay}"
                            AutomationProperties.LabeledBy="{Binding ElementName=AutoClearCompletedDownloadsTitleText}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Margin="0,4,0,0"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE916;"
                            AutomationProperties.AccessibilityView="Raw" />

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="AutoClearDelayTitleText"
                                x:Uid="AutoClearDelayTitle"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Auto-clear delay" />
                            <TextBlock
                                x:Uid="AutoClearDelayDescription"
                                Style="{StaticResource SettingsCardDescriptionTextBlockStyle}"
                                Text="Set how many seconds finished downloads remain visible before they are cleared." />
                        </StackPanel>

                        <NumberBox
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Minimum="0"
                            Maximum="60"
                            MinWidth="160"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.AutoClearCompletedDownloadsDelaySeconds, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.AutoClearCompletedDownloads, Mode=OneWay}"
                            AutomationProperties.LabeledBy="{Binding ElementName=AutoClearDelayTitleText}" />
                    </Grid>
                </Border>

                <TextBlock
                    x:Uid="AwsLoginSectionHeader"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="AWS login defaults"
                    AutomationProperties.HeadingLevel="Level2" />

                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Margin="0,4,0,0"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE774;"
                            AutomationProperties.AccessibilityView="Raw" />

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="DefaultRegionTitleText"
                                x:Uid="DefaultRegionTitle"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Default region" />
                            <TextBlock
                                x:Uid="DefaultRegionDescription"
                                Style="{StaticResource SettingsCardDescriptionTextBlockStyle}"
                                Text="Preselect the region users see first on the sign-in page." />
                        </StackPanel>

                        <ComboBox
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            MinWidth="220"
                            ItemsSource="{x:Bind ViewModel.AvailableRegions}"
                            SelectedItem="{x:Bind ViewModel.DefaultRegion, Mode=TwoWay}"
                            AutomationProperties.LabeledBy="{Binding ElementName=DefaultRegionTitleText}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Margin="0,4,0,0"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE72E;"
                            AutomationProperties.AccessibilityView="Raw" />

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="CredentialChainTitleText"
                                x:Uid="CredentialChainTitle"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Use credential chain by default" />
                            <TextBlock
                                x:Uid="CredentialChainDescription"
                                Style="{StaticResource SettingsCardDescriptionTextBlockStyle}"
                                Text="Start with the default AWS credential chain enabled when users open the sign-in page." />
                        </StackPanel>

                        <ToggleSwitch
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            MinWidth="0"
                            IsOn="{x:Bind ViewModel.UseCredentialChainByDefault, Mode=TwoWay}"
                            AutomationProperties.LabeledBy="{Binding ElementName=CredentialChainTitleText}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Margin="0,4,0,0"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE77B;"
                            AutomationProperties.AccessibilityView="Raw" />

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="PreferredProfileTitleText"
                                x:Uid="PreferredProfileTitle"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Preferred profile name" />
                            <TextBlock
                                x:Uid="PreferredProfileDescription"
                                Style="{StaticResource SettingsCardDescriptionTextBlockStyle}"
                                Text="Leave blank to fall back to Automatic (recommended)." />
                        </StackPanel>

                        <TextBox
                            x:Uid="PreferredProfileInput"
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            MinWidth="220"
                            PlaceholderText="Automatic (recommended)"
                            Text="{x:Bind ViewModel.LastProfileName, Mode=TwoWay}"
                            AutomationProperties.LabeledBy="{Binding ElementName=PreferredProfileTitleText}" />
                    </Grid>
                </Border>

                <TextBlock
                    x:Uid="AccountSectionHeader"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="Account"
                    AutomationProperties.HeadingLevel="Level2" />

                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Margin="0,4,0,0"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xF3B1;"
                            AutomationProperties.AccessibilityView="Raw" />

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Uid="SignOutTitle"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Sign out" />
                            <TextBlock
                                x:Uid="SignOutDescription"
                                Style="{StaticResource SettingsCardDescriptionTextBlockStyle}"
                                Text="Return to the sign-in page and switch to a different AWS account." />
                        </StackPanel>

                        <Button
                            x:Uid="SignOutButton"
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            Command="{x:Bind ViewModel.LogoutCommand}"
                            Content="Sign out" />
                    </Grid>
                </Border>

                <TextBlock
                    x:Uid="AboutSectionHeader"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="About"
                    AutomationProperties.HeadingLevel="Level2" />

                <Border
                    Margin="0,0,0,36"
                    Style="{StaticResource SettingsCardBorderStyle}">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Image
                                x:Uid="PailLogoImage"
                                Width="44"
                                Height="44"
                                VerticalAlignment="Top"
                                Source="ms-appx:///Assets/StoreLogo.png"
                                AutomationProperties.Name="Pail logo" />

                            <StackPanel
                                Grid.Column="1"
                                Spacing="2">
                                <TextBlock
                                    x:Uid="AboutAppName"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="Pail" />
                                <TextBlock
                                    x:Uid="AboutAppDescription"
                                    Style="{StaticResource SettingsCardDescriptionTextBlockStyle}"
                                    Text="AWS S3 browser for Windows." />
                            </StackPanel>

                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind AppVersion}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <HyperlinkButton
                                x:Uid="GitHubLink"
                                Content="GitHub repository"
                                NavigateUri="https://github.com/TheBlueSky/Pail" />
                            <HyperlinkButton
                                x:Uid="ReleasesLink"
                                Content="Releases"
                                NavigateUri="https://github.com/TheBlueSky/Pail/releases" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
