<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pail.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Pail.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:appControls="using:Pail.App.Controls"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:AppThemeModeDisplayConverter x:Key="AppThemeModeDisplayConverter" />

        <x:Double x:Key="SettingsCardSpacing">4</x:Double>

        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="0,30,0,6" />
        </Style>

        <Style x:Key="SettingsCardBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        </Style>

        <Style
            x:Key="SettingsCardDescriptionTextBlockStyle"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            MaxWidth="1064"
            Margin="36,24,36,0"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Settings" />
                <TextBlock
                    Style="{StaticResource SettingsCardDescriptionTextBlockStyle}"
                    Text="Configure how Pail looks and which defaults it uses when you sign in, browse, and download." />
            </StackPanel>

            <Button
                Grid.Column="1"
                MinWidth="120"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.SaveCommand}"
                Content="Save"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Padding="36,0,36,0"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel
                MaxWidth="1064"
                HorizontalAlignment="Center"
                Spacing="{StaticResource SettingsCardSpacing}">
                <StackPanel.ChildrenTransitions>
                    <RepositionThemeTransition />
                </StackPanel.ChildrenTransitions>

                <TextBlock
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="Appearance &amp; behavior" />

                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Margin="0,4,0,0"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE790;" />

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="App theme" />
                            <TextBlock
                                Style="{StaticResource SettingsCardDescriptionTextBlockStyle}"
                                Text="Choose whether the app follows the system theme or always uses a specific mode." />
                        </StackPanel>

                        <ComboBox
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            MinWidth="220"
                            ItemsSource="{x:Bind ViewModel.AvailableThemes}"
                            SelectedItem="{x:Bind ViewModel.AppTheme, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource AppThemeModeDisplayConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Margin="0,4,0,0"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE7F4;" />

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Status messages" />
                            <TextBlock
                                Style="{StaticResource SettingsCardDescriptionTextBlockStyle}"
                                Text="Control how long transient status overlays stay visible before they dismiss." />
                        </StackPanel>

                        <NumberBox
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            MinWidth="160"
                            Minimum="1"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.StatusOverlayDurationSeconds, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <TextBlock
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="Downloads" />

                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Margin="0,4,0,0"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8B7;" />

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Default download folder" />
                            <TextBlock
                                Style="{StaticResource SettingsCardDescriptionTextBlockStyle}"
                                Text="Choose where downloaded objects go unless you pick a different location." />
                        </StackPanel>

                        <Grid
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            MinWidth="360"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                Grid.Column="0"
                                PlaceholderText="e.g. C:\Downloads\Pail"
                                Text="{x:Bind ViewModel.DownloadFolder, Mode=TwoWay}" />
                            <Button
                                Grid.Column="1"
                                Command="{x:Bind ViewModel.BrowseDownloadFolderCommand}"
                                Content="Browse" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Margin="0,4,0,0"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xF89A;" />

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Download prompts" />
                            <TextBlock
                                Style="{StaticResource SettingsCardDescriptionTextBlockStyle}"
                                Text="Ask for a location every time before downloading an object." />
                        </StackPanel>

                        <ToggleSwitch
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            MinWidth="0"
                            IsOn="{x:Bind ViewModel.AlwaysPromptDownloadLocation, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <TextBlock
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="AWS login defaults" />

                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Margin="0,4,0,0"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE774;" />

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Default region" />
                            <TextBlock
                                Style="{StaticResource SettingsCardDescriptionTextBlockStyle}"
                                Text="Preselect the region users see first on the sign-in page." />
                        </StackPanel>

                        <ComboBox
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            MinWidth="220"
                            ItemsSource="{x:Bind ViewModel.AvailableRegions}"
                            SelectedItem="{x:Bind ViewModel.DefaultRegion, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Margin="0,4,0,0"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE72E;" />

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Use credential chain by default" />
                            <TextBlock
                                Style="{StaticResource SettingsCardDescriptionTextBlockStyle}"
                                Text="Start with the default AWS credential chain enabled when users open the sign-in page." />
                        </StackPanel>

                        <ToggleSwitch
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            MinWidth="0"
                            IsOn="{x:Bind ViewModel.UseCredentialChainByDefault, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Margin="0,4,0,0"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE77B;" />

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Preferred profile name" />
                            <TextBlock
                                Style="{StaticResource SettingsCardDescriptionTextBlockStyle}"
                                Text="Leave blank to fall back to Automatic (recommended)." />
                        </StackPanel>

                        <TextBox
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            MinWidth="220"
                            PlaceholderText="Automatic (recommended)"
                            Text="{x:Bind ViewModel.LastProfileName, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <TextBlock
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="Account" />

                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Margin="0,4,0,0"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xF3B1;" />

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Sign out" />
                            <TextBlock
                                Style="{StaticResource SettingsCardDescriptionTextBlockStyle}"
                                Text="Return to the sign-in page and switch to a different AWS account." />
                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            Command="{x:Bind ViewModel.LogoutCommand}"
                            Content="Sign out" />
                    </Grid>
                </Border>

                <TextBlock
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="About" />

                <Border
                    Margin="0,0,0,36"
                    Style="{StaticResource SettingsCardBorderStyle}">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Image
                                Width="44"
                                Height="44"
                                VerticalAlignment="Top"
                                Source="ms-appx:///Assets/StoreLogo.png" />

                            <StackPanel
                                Grid.Column="1"
                                Spacing="2">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="Pail" />
                                <TextBlock
                                    Style="{StaticResource SettingsCardDescriptionTextBlockStyle}"
                                    Text="AWS S3 browser for Windows." />
                            </StackPanel>

                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind AppVersion}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <HyperlinkButton
                                Content="GitHub repository"
                                NavigateUri="https://github.com/TheBlueSky/Pail" />
                            <HyperlinkButton
                                Content="Releases"
                                NavigateUri="https://github.com/TheBlueSky/Pail/releases" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <appControls:StatusOverlayHost Canvas.ZIndex="10" />
    </Grid>
</Page>
