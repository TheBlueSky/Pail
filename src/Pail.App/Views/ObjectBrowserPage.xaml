<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pail.App.Views.ObjectBrowserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tableView="using:WinUI.TableView"
    xmlns:models="using:Pail.Models"
    xmlns:converters="using:Pail.App.Converters"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:FolderIconConverter x:Key="FolderIconConverter"/>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <TextBlock Text="Browser" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
            <TextBlock Text="{x:Bind ViewModel.CurrentPath, Mode=OneWay}" VerticalAlignment="Center" Foreground="Gray"/>
        </StackPanel>

        <CommandBar Grid.Row="1" HorizontalAlignment="Left" Background="Transparent" DefaultLabelPosition="Right">
            <AppBarButton Icon="Refresh" Label="Refresh" Command="{x:Bind ViewModel.LoadItemsCommand}" ToolTipService.ToolTip="Refresh (Ctrl+R, F5)">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="R" Modifiers="Control"/>
                    <KeyboardAccelerator Key="F5" Modifiers="None"/>
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton Icon="Copy" Label="Copy Name" Click="OnCopyNameClick" ToolTipService.ToolTip="Copy Name (Ctrl+C)"/>
            <AppBarButton Icon="Copy" Label="Copy Full Key" Click="OnCopyFullKeyClick" ToolTipService.ToolTip="Copy Full Key (Ctrl+Shift+C)"/>
            <AppBarButton Icon="Download" Label="Download Selected" Click="OnDownloadClick">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="D" Modifiers="Control"/>
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
        </CommandBar>

        <tableView:TableView
            x:Name="ObjectGrid"
            Grid.Row="2"
            ItemsSource="{x:Bind ViewModel.Items}"
            AutoGenerateColumns="False"
            HeadersVisibility="Columns"
            IsReadOnly="True"
            SelectionMode="Extended"
            SelectionUnit="Row"
            CanSortColumns="True"
            CanFilterColumns="True"
            CornerButtonMode="None"
            PreviewKeyDown="OnGridPreviewKeyDown"
            CopyToClipboard="OnGridCopyToClipboard"
            RowContextFlyoutOpening="OnGridRowContextFlyoutOpening"
            CellDoubleTapped="OnGridCellDoubleTapped">

            <tableView:TableView.RowContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Copy Name" Icon="Copy" Click="OnCopyObjectNameContextClick"/>
                    <MenuFlyoutItem Text="Copy Full Key" Icon="Copy" Click="OnCopyObjectFullKeyContextClick"/>
                </MenuFlyout>
            </tableView:TableView.RowContextFlyout>

            <tableView:TableView.Columns>
                <tableView:TableViewTemplateColumn Header="" Width="44">
                    <tableView:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:S3ObjectItem">
                            <Grid>
                                <SymbolIcon
                                    Symbol="{x:Bind IsFolder, Converter={StaticResource FolderIconConverter}}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </tableView:TableViewTemplateColumn.CellTemplate>
                </tableView:TableViewTemplateColumn>
                <tableView:TableViewTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <tableView:TableViewTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="100"/>
                <tableView:TableViewTextColumn Header="Last Modified" Binding="{Binding LastModified}" Width="180"/>
            </tableView:TableView.Columns>
        </tableView:TableView>

        <ProgressRing Grid.Row="2" IsActive="{x:Bind ViewModel.IsInitialLoadInProgress, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <Grid Grid.Row="3" Margin="0,12,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.LoadedItemsStatus, Mode=OneWay}" />

            <ProgressRing
                Grid.Column="1"
                Width="18"
                Height="18"
                IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}"
                VerticalAlignment="Center" />

            <Button Grid.Column="2" Command="{x:Bind ViewModel.LoadMoreCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE895;" />
                    <TextBlock Text="Load more" />
                </StackPanel>
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="M" Modifiers="Control"/>
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>
    </Grid>
</Page>
