<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pail.App.Views.ObjectBrowserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tableView="using:WinUI.TableView"
    xmlns:viewModels="using:Pail.ViewModels"
    xmlns:converters="using:Pail.App.Converters"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:FolderIconConverter x:Key="FolderIconConverter"/>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator x:Name="SearchKeyboardAcceleratorF" Key="F" Modifiers="Control" Invoked="OnPageKeyboardAcceleratorInvoked" />
        <KeyboardAccelerator x:Name="SearchKeyboardAcceleratorF3" Key="F3" Modifiers="None" Invoked="OnPageKeyboardAcceleratorInvoked"/>
    </Page.KeyboardAccelerators>

    <Grid
        x:Uid="ObjectBrowserMainRegion"
        Margin="24"
        AutomationProperties.LandmarkType="Main"
        AutomationProperties.LocalizedLandmarkType="Object browser">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid
            x:Uid="ObjectSearchRegion"
            Margin="0,0,0,12"
            ColumnSpacing="12"
            AutomationProperties.LandmarkType="Search"
            AutomationProperties.LocalizedLandmarkType="Search objects">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="{x:Bind ViewModel.LocationBreadcrumb, Mode=OneWay}"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                ToolTipService.ToolTip="{x:Bind ViewModel.LocationBreadcrumb, Mode=OneWay}"/>
            <TextBox
                x:Uid="ObjectSearchTextBox"
                x:Name="SearchTextBox"
                Grid.Column="1"
                MinWidth="240"
                MaxWidth="400"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                PlaceholderText="Search objects"
                AutomationProperties.Name="Search objects"
                AutomationProperties.AcceleratorKey="Ctrl+F, F3"
                TextChanged="OnSearchTextChanged"
                ToolTipService.ToolTip="Search objects (Ctrl+F or F3)"/>
        </Grid>

        <CommandBar
            x:Uid="ObjectBrowserCommandBar"
            Grid.Row="1"
            HorizontalAlignment="Left"
            Background="Transparent"
            DefaultLabelPosition="Right"
            AutomationProperties.LandmarkType="Navigation"
            AutomationProperties.LocalizedLandmarkType="Object commands">

            <AppBarButton
                x:Uid="RefreshButton"
                Icon="Refresh"
                Label="Refresh"
                Command="{x:Bind ViewModel.LoadItemsCommand}"
                AutomationProperties.AcceleratorKey="Ctrl+R, F5"
                ToolTipService.ToolTip="Refresh (Ctrl+R, F5)">

                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="R" Modifiers="Control"/>
                    <KeyboardAccelerator Key="F5" Modifiers="None"/>
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton
                x:Uid="CopyNameButton"
                Icon="Copy"
                Label="Copy Name"
                Click="OnCopyNameClick"
                AutomationProperties.AcceleratorKey="Ctrl+C"
                ToolTipService.ToolTip="Copy Name (Ctrl+C)"/>
            <AppBarButton
                x:Uid="CopyFullKeyButton"
                Icon="Copy"
                Label="Copy Full Key"
                Click="OnCopyFullKeyClick"
                AutomationProperties.AcceleratorKey="Ctrl+Shift+C"
                ToolTipService.ToolTip="Copy Full Key (Ctrl+Shift+C)"/>
            <AppBarButton
                x:Uid="DownloadSelectedButton"
                Icon="Download"
                Label="Download Selected"
                Click="OnDownloadClick"
                AutomationProperties.AcceleratorKey="Ctrl+D"
                ToolTipService.ToolTip="Download Selected (Ctrl+D)">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="D" Modifiers="Control"/>
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
        </CommandBar>

        <tableView:TableView
            x:Uid="ObjectTableView"
            x:Name="ObjectGrid"
            Grid.Row="2"
            ItemsSource="{x:Bind ViewModel.Items}"
            AutoGenerateColumns="False"
            HeadersVisibility="Columns"
            IsReadOnly="True"
            SelectionMode="Extended"
            SelectionUnit="Row"
            CanSortColumns="True"
            CanFilterColumns="False"
            CornerButtonMode="None"
            PreviewKeyDown="OnGridPreviewKeyDown"
            CopyToClipboard="OnGridCopyToClipboard"
            RowContextFlyoutOpening="OnGridRowContextFlyoutOpening"
            CellDoubleTapped="OnGridCellDoubleTapped"
            AutomationProperties.Name="S3 objects table">

            <tableView:TableView.RowContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Uid="ObjectCopyNameContext" Text="Copy Name" Icon="Copy" Click="OnCopyObjectNameContextClick"/>
                    <MenuFlyoutItem x:Uid="ObjectCopyFullKeyContext" Text="Copy Full Key" Icon="Copy" Click="OnCopyObjectFullKeyContextClick"/>
                </MenuFlyout>
            </tableView:TableView.RowContextFlyout>

            <tableView:TableView.Columns>
                <tableView:TableViewTemplateColumn Header="" Width="44">
                    <tableView:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="viewModels:ObjectBrowserItemViewModel">
                            <Grid>
                                <SymbolIcon
                                    Symbol="{x:Bind IsFolder, Converter={StaticResource FolderIconConverter}}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AccessibilityView="Raw"/>
                            </Grid>
                        </DataTemplate>
                    </tableView:TableViewTemplateColumn.CellTemplate>
                </tableView:TableViewTemplateColumn>
                <tableView:TableViewTextColumn x:Uid="ObjectNameColumn" Header="Name" Binding="{Binding Name}" Width="*"/>
                <tableView:TableViewTextColumn x:Uid="ObjectSizeColumn" Header="Size" Binding="{Binding SizeDisplay}" Width="100"/>
                <tableView:TableViewTextColumn x:Uid="ObjectLastModifiedColumn" Header="Last Modified" Binding="{Binding LastModifiedDisplay}" Width="200"/>
            </tableView:TableView.Columns>
        </tableView:TableView>

        <ProgressRing Grid.Row="2" IsActive="{x:Bind ViewModel.IsInitialLoadInProgress, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>

        <Grid Grid.Row="3" Margin="0,12,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.LoadedItemsStatus, Mode=OneWay}"
                AutomationProperties.LiveSetting="Polite" />

            <ProgressRing
                Grid.Column="1"
                Width="18"
                Height="18"
                IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw" />

            <Button
                x:Uid="LoadMoreButton"
                Grid.Column="2"
                Command="{x:Bind ViewModel.LoadMoreCommand}"
                AutomationProperties.AcceleratorKey="Ctrl+M">

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE895;" AutomationProperties.AccessibilityView="Raw"/>
                    <TextBlock x:Uid="LoadMoreText" Text="Load more" />
                </StackPanel>
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="M" Modifiers="Control"/>
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>
    </Grid>
</Page>
