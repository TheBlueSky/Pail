<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pail.App.Views.BucketListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Pail.Models"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <Style x:Key="BucketCreationDateTextBlockStyle" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Style>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <Style x:Key="BucketCreationDateTextBlockStyle" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Style>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <Style x:Key="BucketCreationDateTextBlockStyle" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Style>
                </ResourceDictionary>

                <ResourceDictionary x:Key="HighContrast">
                    <Style x:Key="BucketCreationDateTextBlockStyle" TargetType="TextBlock" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator x:Name="SearchKeyboardAcceleratorF" Key="F" Modifiers="Control" Invoked="OnPageKeyboardAcceleratorInvoked" />
        <KeyboardAccelerator x:Name="SearchKeyboardAcceleratorF3" Key="F3" Modifiers="None" Invoked="OnPageKeyboardAcceleratorInvoked"/>
    </Page.KeyboardAccelerators>

    <Grid
        x:Uid="BucketListMainRegion"
        Margin="24"
        AutomationProperties.LandmarkType="Main"
        AutomationProperties.LocalizedLandmarkType="Bucket list">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid
            x:Uid="BucketSearchRegion"
            Margin="0,0,0,12"
            ColumnSpacing="12"
            AutomationProperties.LandmarkType="Search"
            AutomationProperties.LocalizedLandmarkType="Search buckets">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Uid="BucketListTitle"
                Grid.Column="0"
                Text="S3 Buckets"
                Style="{StaticResource TitleTextBlockStyle}"
                VerticalAlignment="Center"
                AutomationProperties.HeadingLevel="Level1"/>
            <TextBox
                x:Uid="SearchTextBox"
                x:Name="SearchTextBox"
                Grid.Column="1"
                TabIndex="0"
                MinWidth="240"
                MaxWidth="400"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                PlaceholderText="Search buckets"
                AutomationProperties.Name="Search buckets"
                AutomationProperties.AcceleratorKey="Ctrl+F, F3"
                TextChanged="OnSearchTextChanged"
                ToolTipService.ToolTip="Search buckets (Ctrl+F or F3)"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                <Button
                    x:Uid="ReloadBucketsButton"
                    Command="{x:Bind ViewModel.LoadBucketsCommand}"
                    TabIndex="2"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Reload buckets"
                    AutomationProperties.AcceleratorKey="Ctrl+R, F5"
                    ToolTipService.ToolTip="Reload buckets (Ctrl+R or F5)">
                    <FontIcon Glyph="&#xE72C;" AutomationProperties.AccessibilityView="Raw"/>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="R" Modifiers="Control"/>
                        <KeyboardAccelerator Key="F5" Modifiers="None"/>
                    </Button.KeyboardAccelerators>
                </Button>
                <Button
                    x:Uid="CopyBucketNameButton"
                    Command="{x:Bind ViewModel.CopyBucketNameCommand}"
                    TabIndex="3"
                    VerticalAlignment="Center"
                    AutomationProperties.AcceleratorKey="Ctrl+C"
                    ToolTipService.ToolTip="Copy bucket name (Ctrl+C)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE77F;" AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock x:Uid="CopyBucketNameText" Text="Copy Bucket Name" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="C" Modifiers="Control"/>
                    </Button.KeyboardAccelerators>
                </Button>
            </StackPanel>
        </Grid>

        <ListView
            x:Uid="BucketListView"
            Grid.Row="1"
            TabIndex="1"
            ItemsSource="{x:Bind ViewModel.Buckets}"
            SelectedItem="{x:Bind ViewModel.SelectedBucket, Mode=TwoWay}"
            SelectionMode="Single"
            IsItemClickEnabled="True"
            PreviewKeyDown="OnBucketListPreviewKeyDown"
            DoubleTapped="OnBucketDoubleTapped"
            AutomationProperties.Name="List of S3 buckets">

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:S3BucketItem">
                    <Grid Padding="12">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Uid="BucketCopyNameContext" Text="Copy Bucket Name" Icon="Copy" Click="OnBucketCopyNameContextClick"/>
                            </MenuFlyout>
                        </Grid.ContextFlyout>

                        <StackPanel>
                            <TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind CreationDate}" FontSize="12" Style="{ThemeResource BucketCreationDateTextBlockStyle}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ProgressRing Grid.Row="1" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
    </Grid>
</Page>
