<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pail.App.Views.BucketListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Pail.Models"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator x:Name="SearchKeyboardAcceleratorF" Key="F" Modifiers="Control" Invoked="OnPageKeyboardAcceleratorInvoked" />
        <KeyboardAccelerator x:Name="SearchKeyboardAcceleratorF3" Key="F3" Modifiers="None" Invoked="OnPageKeyboardAcceleratorInvoked"/>
    </Page.KeyboardAccelerators>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="S3 Buckets" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
            <TextBox
                x:Name="SearchTextBox"
                Grid.Column="1"
                MinWidth="240"
                MaxWidth="400"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                PlaceholderText="Search buckets"
                AutomationProperties.Name="Search buckets"
                TextChanged="OnSearchTextChanged"
                ToolTipService.ToolTip="Search buckets (Ctrl+F or F3)"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                <Button Command="{x:Bind ViewModel.LoadBucketsCommand}" VerticalAlignment="Center" ToolTipService.ToolTip="Reload buckets (Ctrl+R or F5)">
                    <FontIcon Glyph="&#xE72C;" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="R" Modifiers="Control"/>
                        <KeyboardAccelerator Key="F5" Modifiers="None"/>
                    </Button.KeyboardAccelerators>
                </Button>
                <Button Command="{x:Bind ViewModel.CopyBucketNameCommand}" VerticalAlignment="Center" ToolTipService.ToolTip="Copy bucket name (Ctrl+C)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE77F;" />
                        <TextBlock Text="Copy Bucket Name" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="C" Modifiers="Control"/>
                    </Button.KeyboardAccelerators>
                </Button>
            </StackPanel>
        </Grid>

        <ListView
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Buckets}"
            SelectedItem="{x:Bind ViewModel.SelectedBucket, Mode=TwoWay}"
            SelectionMode="Single"
            IsItemClickEnabled="True"
            PreviewKeyDown="OnBucketListPreviewKeyDown"
            DoubleTapped="OnBucketDoubleTapped">

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:S3BucketItem">
                    <Grid Padding="12">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Copy Bucket Name" Icon="Copy" Click="OnBucketCopyNameContextClick"/>
                            </MenuFlyout>
                        </Grid.ContextFlyout>

                        <StackPanel>
                            <TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind CreationDate}" FontSize="12" Foreground="Gray"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ProgressRing Grid.Row="1" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Grid>
</Page>
