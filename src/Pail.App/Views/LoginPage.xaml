<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pail.App.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Pail.ViewModels"
    xmlns:converters="using:Pail.App.Converters"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </Page.Resources>

    <Grid
        x:Uid="LoginMainRegion"
        AutomationProperties.LandmarkType="Main"
        AutomationProperties.LocalizedLandmarkType="Sign in">
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400" Width="400">
            <StackPanel Spacing="12">
                <TextBlock x:Uid="LoginTitle" Text="Pail" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" AutomationProperties.HeadingLevel="Level1"/>

                <ComboBox
                    x:Uid="RegionCombo"
                    Header="Region"
                    HorizontalAlignment="Stretch"
                    IsEditable="True"
                    IsTextSearchEnabled="True"
                    ItemsSource="{x:Bind ViewModel.AvailableRegions, Mode=OneWay}"
                    Text="{x:Bind ViewModel.Region, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Border Height="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}"/>

                <Button
                    x:Uid="PasteCredentialsButton"
                    Command="{x:Bind ViewModel.PasteCredentialsCommand}"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Paste AWS Console Credentials"
                    AutomationProperties.AcceleratorKey="Ctrl+Shift+P"
                    ToolTipService.ToolTip="Paste AWS Console Credentials (Shift+Ctrl+P)">

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE77F;" AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock x:Uid="PasteCredentialsText" Text="Paste AWS Console Credentials" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="P" Modifiers="Control,Shift"/>
                    </Button.KeyboardAccelerators>
                </Button>

                <TextBox
                    x:Uid="AccessKeyInput"
                    Header="Access Key"
                    Text="{x:Bind ViewModel.AccessKey, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.UseDefaultChain, Converter={StaticResource InverseBooleanConverter}, Mode=OneWay}"/>
                <PasswordBox
                    x:Uid="SecretKeyInput"
                    Header="Secret Key"
                    Password="{x:Bind ViewModel.SecretKey, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.UseDefaultChain, Converter={StaticResource InverseBooleanConverter}, Mode=OneWay}"/>
                <TextBox
                    x:Uid="SessionTokenInput"
                    Header="Session Token (Optional)"
                    Text="{x:Bind ViewModel.SessionToken, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.UseDefaultChain, Converter={StaticResource InverseBooleanConverter}, Mode=OneWay}"/>

                <Border Height="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}"/>

                <CheckBox
                    x:Uid="DefaultChainCheckBox"
                    Content="Use Default Credential Chain"
                    IsChecked="{x:Bind ViewModel.UseDefaultChain, Mode=TwoWay}"
                    AutomationProperties.AcceleratorKey="Ctrl+Shift+D"
                    ToolTipService.ToolTip="Use the default AWS credential chain (Ctrl+Shift+D)">
                    <CheckBox.KeyboardAccelerators>
                        <KeyboardAccelerator Key="D" Modifiers="Control,Shift"/>
                    </CheckBox.KeyboardAccelerators>
                </CheckBox>
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="AwsProfileLabel" x:Name="AwsProfileLabelText" Text="AWS Profile" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox
                            x:Name="AwsProfileComboBox"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.AvailableProfiles, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedProfileName, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.UseDefaultChain, Mode=OneWay}"
                            AutomationProperties.LabeledBy="{Binding ElementName=AwsProfileLabelText}"/>

                        <Button
                            x:Uid="RefreshProfilesButton"
                            Grid.Column="1"
                            Width="{Binding ElementName=AwsProfileComboBox, Path=ActualHeight, Mode=OneWay}"
                            Height="{Binding ElementName=AwsProfileComboBox, Path=ActualHeight, Mode=OneWay}"
                            Padding="0"
                            Command="{x:Bind ViewModel.LoadCredentialProfilesCommand}"
                            IsEnabled="{x:Bind ViewModel.CanRefreshProfiles, Mode=OneWay}"
                            AutomationProperties.Name="Refresh AWS profiles"
                            AutomationProperties.AcceleratorKey="Ctrl+R"
                            ToolTipService.ToolTip="Refresh AWS profiles (Ctrl+R)">

                            <FontIcon Glyph="&#xE72C;" AutomationProperties.AccessibilityView="Raw"/>
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="R" Modifiers="Control"/>
                            </Button.KeyboardAccelerators>
                        </Button>
                    </Grid>
                </StackPanel>

                <Button
                    x:Uid="SignInButton"
                    Content="Sign In"
                    Command="{x:Bind ViewModel.LoginCommand}"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource AccentButtonStyle}" Margin="0,10,0,0"
                    AutomationProperties.AcceleratorKey="Ctrl+Shift+S"
                    ToolTipService.ToolTip="Sign in (Ctrl+Shift+S)">

                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control,Shift"/>
                    </Button.KeyboardAccelerators>
                </Button>

                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" HorizontalAlignment="Center" Margin="0,10,0,0" AutomationProperties.AccessibilityView="Raw"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
