<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pail.App.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Pail.ViewModels"
    xmlns:converters="using:Pail.App.Converters"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </Page.Resources>

    <Grid>
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400" Width="400">
            <StackPanel Spacing="12">
                <TextBlock Text="Pail" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <ComboBox
                    Header="Region"
                    HorizontalAlignment="Stretch"
                    IsEditable="True"
                    IsTextSearchEnabled="True"
                    ItemsSource="{x:Bind ViewModel.AvailableRegions, Mode=OneWay}"
                    Text="{x:Bind ViewModel.Region, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Border Height="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}"/>

                <Button Command="{x:Bind ViewModel.PasteCredentialsCommand}" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Paste AWS Console Credentials (Shift+Ctrl+P)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE77F;" />
                        <TextBlock Text="Paste AWS Console Credentials" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="P" Modifiers="Control,Shift"/>
                    </Button.KeyboardAccelerators>
                </Button>

                <TextBox Header="Access Key" Text="{x:Bind ViewModel.AccessKey, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.UseDefaultChain, Converter={StaticResource InverseBooleanConverter}, Mode=OneWay}"/>
                <PasswordBox Header="Secret Key" Password="{x:Bind ViewModel.SecretKey, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.UseDefaultChain, Converter={StaticResource InverseBooleanConverter}, Mode=OneWay}"/>
                <TextBox Header="Session Token (Optional)" Text="{x:Bind ViewModel.SessionToken, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.UseDefaultChain, Converter={StaticResource InverseBooleanConverter}, Mode=OneWay}"/>

                <Border Height="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                <CheckBox Content="Use Default Credential Chain" IsChecked="{x:Bind ViewModel.UseDefaultChain, Mode=TwoWay}" ToolTipService.ToolTip="Use the default AWS credential chain (Ctrl+Shift+D)">
                    <CheckBox.KeyboardAccelerators>
                        <KeyboardAccelerator Key="D" Modifiers="Control,Shift"/>
                    </CheckBox.KeyboardAccelerators>
                </CheckBox>
                <StackPanel Spacing="4">
                    <TextBlock Text="AWS Profile" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox
                            x:Name="AwsProfileComboBox"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.AvailableProfiles, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedProfileName, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.UseDefaultChain, Mode=OneWay}"
                            AutomationProperties.Name="AWS Profile"/>

                        <Button
                            Grid.Column="1"
                            Width="{Binding ElementName=AwsProfileComboBox, Path=ActualHeight, Mode=OneWay}"
                            Height="{Binding ElementName=AwsProfileComboBox, Path=ActualHeight, Mode=OneWay}"
                            Padding="0"
                            Command="{x:Bind ViewModel.LoadCredentialProfilesCommand}"
                            IsEnabled="{x:Bind ViewModel.CanRefreshProfiles, Mode=OneWay}"
                            AutomationProperties.Name="Refresh AWS profiles"
                            ToolTipService.ToolTip="Refresh AWS profiles (Ctrl+R)">

                            <FontIcon Glyph="&#xE72C;" />
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="R" Modifiers="Control"/>
                            </Button.KeyboardAccelerators>
                        </Button>
                    </Grid>
                </StackPanel>

                <Button
                    Content="Sign In"
                    Command="{x:Bind ViewModel.LoginCommand}"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource AccentButtonStyle}" Margin="0,10,0,0"
                    ToolTipService.ToolTip="Sign in (Ctrl+Shift+S)">

                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control,Shift"/>
                    </Button.KeyboardAccelerators>
                </Button>

                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
